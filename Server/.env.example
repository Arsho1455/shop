# Copy to Server/.env and replace placeholders with your own private values.
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=you@gmail.com
CONTACT_TO_EMAIL=your-business-email@gmail.com

# Simulation only. No card payments are processed.
DEMO_CHECKOUT_ENABLED=true
# Optional delivery cost in AMD; 0 = free.
SHIPPING_FEE_AMD=0
